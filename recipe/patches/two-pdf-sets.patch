diff --git a/src/luminosity.cc b/src/luminosity.cc
index 35032d2..029d5e5 100644
--- a/src/luminosity.cc
+++ b/src/luminosity.cc
@@ -316,16 +316,22 @@ namespace lumi {
   double VsqAsq_d(double M, double alpha){
     return EW::e_d*EW::e_d + N_Zgamma(M,alpha)*EW::e_d*v_d_Z + N_Z(M,alpha)*(v_d_Z*v_d_Z + a_d_Z*a_d_Z) ;
   }
-  double lumi_DYn(PDFs *pdfs, double x1, double x2, double mu, double M, collider c) { // neutral (Z+gamma)
+  // PDFs of hadron 2: from the same set (pp, ppbar, pd) or from a second set (twoSets)
+  void hadron2(PDFs *pdfs, PDFs *pdfs2, double x2, double mu, double *xfx2, collider c) {
+    if     (c==pp)    pdfs->xfx(x2, mu, xfx2);
+    else if(c==ppbar) pdfs->xfx(x2, mu, xfx2, Proton, true);
+    else if(c==pd)    pdfs->xfx(x2, mu, xfx2, Deuteron);
+    else if(c==twoSets && pdfs2) pdfs2->xfx(x2, mu, xfx2);
+    else abort(); // twoSets without a second set, or a DIS collider
+  }
+  double lumi_DYn(PDFs *pdfs, double x1, double x2, double mu, double M, collider c, PDFs *pdfs2) { // neutral (Z+gamma)
     //double alpha = EW::alpha_QED(M);
     double alpha = EW::alpha_em_Z;
     double pref_u = VsqAsq_u(M,alpha);
     double pref_d = VsqAsq_d(M,alpha);
     double xfx1[13], xfx2[13];
     pdfs->xfx(x1, mu, xfx1);
-    if     (c==pp)    pdfs->xfx(x2, mu, xfx2);
-    else if(c==ppbar) pdfs->xfx(x2, mu, xfx2, Proton, true);
-    else if(c==pd)    pdfs->xfx(x2, mu, xfx2, Deuteron);
+    hadron2(pdfs, pdfs2, x2, mu, xfx2, c);
     double res = 0;
     for(int i=1; i<=6; i++) {
       if(i%2==0) res += pref_u * (xfx1[6+i]*xfx2[6-i] + xfx1[6-i]*xfx2[6+i]);
@@ -333,12 +339,10 @@ namespace lumi {
     }
     return res/x1/x2;
   }
-  double lumi_DYp(PDFs *pdfs, double x1, double x2, double mu, double M, collider c) { // positive (W+)
+  double lumi_DYp(PDFs *pdfs, double x1, double x2, double mu, double M, collider c, PDFs *pdfs2) { // positive (W+)
     double xfx1[13], xfx2[13];
     pdfs->xfx(x1, mu, xfx1);
-    if     (c==pp)    pdfs->xfx(x2, mu, xfx2);
-    else if(c==ppbar) pdfs->xfx(x2, mu, xfx2, Proton, true);
-    else if(c==pd)    pdfs->xfx(x2, mu, xfx2, Deuteron);
+    hadron2(pdfs, pdfs2, x2, mu, xfx2, c);
     double res = 0;
     res = 0
       + xfx1[6+2] * ( V_ud_sq * xfx2[6-1] + V_us_sq * xfx2[6-3] + V_ub_sq * xfx2[6-5] )
@@ -349,12 +353,10 @@ namespace lumi {
       + xfx2[6+6] * ( V_td_sq * xfx1[6-1] + V_ts_sq * xfx1[6-3] + V_tb_sq * xfx1[6-5] );
     return res/x1/x2;
   }
-  double lumi_DYm(PDFs *pdfs, double x1, double x2, double mu, double M, collider c) { // negative (W-)
+  double lumi_DYm(PDFs *pdfs, double x1, double x2, double mu, double M, collider c, PDFs *pdfs2) { // negative (W-)
     double xfx1[13], xfx2[13];
     pdfs->xfx(x1, mu, xfx1);
-    if     (c==pp)    pdfs->xfx(x2, mu, xfx2);
-    else if(c==ppbar) pdfs->xfx(x2, mu, xfx2, Proton, true);
-    else if(c==pd)    pdfs->xfx(x2, mu, xfx2, Deuteron);
+    hadron2(pdfs, pdfs2, x2, mu, xfx2, c);
     double res = 0;
     res = 0
       + xfx1[6-2] * ( V_ud_sq * xfx2[6+1] + V_us_sq * xfx2[6+3] + V_ub_sq * xfx2[6+5] )
@@ -366,11 +368,11 @@ namespace lumi {
     return res/x1/x2;
   }
   //
-  double lumi_DY(PDFs *pdfs, double x1, double x2, double mu, double M, process p, collider c) {
+  double lumi_DY(PDFs *pdfs, double x1, double x2, double mu, double M, process p, collider c, PDFs *pdfs2) {
     double res;
-    if(p == DYneutral) res = lumi_DYn(pdfs, x1,x2,mu,M,c);
-    else if(p == DYpositive) res = lumi_DYp(pdfs, x1,x2,mu,M,c);
-    else if(p == DYnegative) res = lumi_DYm(pdfs, x1,x2,mu,M,c);
+    if(p == DYneutral) res = lumi_DYn(pdfs, x1,x2,mu,M,c,pdfs2);
+    else if(p == DYpositive) res = lumi_DYp(pdfs, x1,x2,mu,M,c,pdfs2);
+    else if(p == DYnegative) res = lumi_DYm(pdfs, x1,x2,mu,M,c,pdfs2);
     else abort();
     return res;
   }
diff --git a/src/luminosity.hh b/src/luminosity.hh
