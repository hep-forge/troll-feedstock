   //
   using namespace resumm;
   //dQCDResummation res(DYpositive, LHC, PDFset, 0);
-  dQCDResummation res(DYneutral, LHC, PDFset, 0);
+  dQCDResummation res(DYneutral, PDFset2.empty() ? LHC : twoSets, PDFset, 0);
