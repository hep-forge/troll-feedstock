   extern double lumi_gg (PDFinterface::PDFs *pdfs, double x1, double x2, double mu);
-  extern double lumi_DY (PDFinterface::PDFs *pdfs, double x1, double x2, double mu, double M, process p, collider c);
+  extern double lumi_DY (PDFinterface::PDFs *pdfs, double x1, double x2, double mu, double M, process p, collider c, PDFinterface::PDFs *pdfs2=NULL);
   extern double lumi_DIS(PDFinterface::PDFs *pdfs, double x, double mu, int nf, process p, collider c, double y, double TMoQ=0, double mcoQ=0); // nf is the number of active flavours
 
   extern void SetZcoupling(double); // 1: SM, 0: excludes the Z
diff --git a/src/resummation.cc b/src/resummation.cc
index 5a40648..b139981 100644
--- a/src/resummation.cc
+++ b/src/resummation.cc
@@ -50,6 +50,7 @@ namespace resumm {
     proc = p;
     coll = c;
     pdfs = new PDFs(PDFset, PDFmember);
+    pdfs2 = NULL;
     InitMasses        (pdfs->getQuarkMass     (4), pdfs->getQuarkMass     (5), pdfs->getQuarkMass     (6));
     InitMassThresholds(pdfs->getQuarkThreshold(4), pdfs->getQuarkThreshold(5), pdfs->getQuarkThreshold(6));
     Hmtop = pdfs->getQuarkMass(6);
@@ -103,6 +104,12 @@ namespace resumm {
     Hmtop = pdfs->getQuarkMass(6);
   }
 
+  void Resummation::SetSecondHadronPDF(string PDFset, int PDFmember) {
+    delete pdfs2;
+    pdfs2 = new PDFs(PDFset, PDFmember);
+    forceredo = true;
+  }
+
   void Resummation::SetMtop(double mt) {
     Hmtop = mt;
   }
@@ -279,7 +286,7 @@ namespace resumm {
 
 
   // for inclusive cross-section (invariant mass distribution)
-  struct s_lum  { double x, mu, M; process p; collider c; PDFs *pdf; };
+  struct s_lum  { double x, mu, M; process p; collider c; PDFs *pdf; PDFs *pdf2; };
   double Lum_integrand(double z, void* par) {
     s_lum pars = *(s_lum *) par;
     double x   = pars.x;
@@ -288,43 +295,44 @@ namespace resumm {
     process p  = pars.p;
     collider c = pars.c;
     PDFs *pdf  = pars.pdf;
+    PDFs *pdf2 = pars.pdf2;
     double lum;
     if(p == ggH || p == ggA) lum = lumi::lumi_gg(pdf,z,x/z,mu)/z;
-    else lum = lumi::lumi_DY(pdf,z,x/z,mu,M,p,c)/z;
+    else lum = lumi::lumi_DY(pdf,z,x/z,mu,M,p,c,pdf2)/z;
     return lum;
   }
-  double Lum_inclusive(PDFs *pdf, double x, double mu, double M, process p, collider c, int nf, double xTM, double y, double mc) {
+  double Lum_inclusive(PDFs *pdf, double x, double mu, double M, process p, collider c, int nf, double xTM, double y, double mc, PDFs *pdf2=NULL) {
     if(p < 0) { // DIS
       double TMtau = sqrt(1+4*xTM*xTM/M/M);
       return lumi::lumi_DIS(pdf,x,mu,nf,p,c,y,TMtau,mc/M);
     }
     double precision = 1e-4;
-    s_lum pars = {x, mu, M, p, c, pdf};
+    s_lum pars = {x, mu, M, p, c, pdf, pdf2};
     gsl_error_handler_t *old_handler = gsl_set_error_handler (NULL);
     gsl_set_error_handler_off();
     double res = integration::gauss(Lum_integrand,x,1.,precision,NULL,&pars);
     gsl_set_error_handler (old_handler);
     return res;
   }
-  double Lum_inclusive_rescaled(PDFs *pdf, double x, double mu, double M, process p, collider c, int nf, double xTM, double y, double mc) {
+  double Lum_inclusive_rescaled(PDFs *pdf, double x, double mu, double M, process p, collider c, int nf, double xTM, double y, double mc, PDFs *pdf2=NULL) {
     //if(p < 0) { // DIS
     //  x *= 2./(1.+sqrt(1.+4.*TM*TM/M/M)); // target mass correction
     //}
-    return Lum_inclusive(pdf, x, mu, M, p, c, nf, xTM, y, mc);
+    return Lum_inclusive(pdf, x, mu, M, p, c, nf, xTM, y, mc, pdf2);
   }
   // for rapidity distributions
-  double Lum_rapidity(PDFs *pdf, double x, double Y, double mu, double M, process p, collider c) {
+  double Lum_rapidity(PDFs *pdf, double x, double Y, double mu, double M, process p, collider c, PDFs *pdf2=NULL) {
     double x1 = sqrt(x) * exp(Y);
     double x2 = x/x1;  //sqrt(x) * exp(-Y);
     if(x1>=1 || x2>=1) return 0;
     double lum;
     if(p == ggH || p==ggA) lum = lumi::lumi_gg(pdf,x1,x2,mu);
-    else lum = lumi::lumi_DY(pdf,x1,x2,mu,M,p,c);
+    else lum = lumi::lumi_DY(pdf,x1,x2,mu,M,p,c,pdf2);
     return lum;
   }
-  double Lum_rapidity_rescaled(PDFs *pdf, double x, double Y, double mu, double M, process p, collider c) {
+  double Lum_rapidity_rescaled(PDFs *pdf, double x, double Y, double mu, double M, process p, collider c, PDFs *pdf2=NULL) {
     x *= exp(-2*fabs(Y)); // rescaling!!
-    return Lum_rapidity(pdf, x, Y, mu, M, p, c);
+    return Lum_rapidity(pdf, x, Y, mu, M, p, c, pdf2);
   }
   // for general use
   double Lum(double x, void *p) {
@@ -335,18 +343,18 @@ namespace resumm {
     }
     double lum=0;
     if(res->doRapidityDistr)
-      lum = Lum_rapidity (res->pdfs, x, res->rapY, res->muF, res->M, res->proc, res->coll);
+      lum = Lum_rapidity (res->pdfs, x, res->rapY, res->muF, res->M, res->proc, res->coll, res->pdfs2);
     else
-      lum = Lum_inclusive(res->pdfs, x, res->muF, res->M, res->proc, res->coll, res->nf, res->tau*res->TargetMass, res->DISy, res->mass_c);
+      lum = Lum_inclusive(res->pdfs, x, res->muF, res->M, res->proc, res->coll, res->nf, res->tau*res->TargetMass, res->DISy, res->mass_c, res->pdfs2);
     return lum;
   }
   double LumRescaled(double x, void *p) {
     Resummation *res = (Resummation *) p;
     double lum=0;
     if(res->doRapidityDistr)
-      lum = Lum_rapidity_rescaled (res->pdfs, x, res->rapY, res->muF, res->M, res->proc, res->coll);
+      lum = Lum_rapidity_rescaled (res->pdfs, x, res->rapY, res->muF, res->M, res->proc, res->coll, res->pdfs2);
     else
-      lum = Lum_inclusive_rescaled(res->pdfs, x, res->muF, res->M, res->proc, res->coll, res->nf, res->tau*res->TargetMass, res->DISy, res->mass_c);
+      lum = Lum_inclusive_rescaled(res->pdfs, x, res->muF, res->M, res->proc, res->coll, res->nf, res->tau*res->TargetMass, res->DISy, res->mass_c, res->pdfs2);
     return lum;
   }
 
