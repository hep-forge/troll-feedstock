 src/luminosity.cc            | 34 ++++++++++++++++++----------------
 src/luminosity.hh            |  4 +++-
 src/resummation.cc           | 36 ++++++++++++++++++++++--------------
 src/resummation.hh           |  4 ++++
 5 files changed, 59 insertions(+), 34 deletions(-)

