 					 { "fact", 1, NULL, 'f' },
 					 { "ren", 1, NULL, 'r' },
 					 { "mass", 1, NULL, 'm' },
@@ -73,6 +76,9 @@ void read_arguments(int argc, char* argv[], double &mH, double &sqrts, string &s
       sset << optarg;
